# Shortcut to this dotfiles
export DOTFILES=$HOME/.dotfiles

# Path to your oh-my-zsh configuration.
export ZSH=$DOTFILES/zsh/ohmyzsh.git

# Projects folder
export PROJECTS=~/Documents/projects/

# Set custom theme
ZSH_CUSTOM=$DOTFILES/zsh/custom/

# Set name of the theme to load.
ZSH_THEME="powerlevel9k/powerlevel9k"

POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=( context virtualenv  dir vcs)
POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=( status root_indicator history  time)


# Comment this out to disable bi-weekly auto-update checks
DISABLE_AUTO_UPDATE="true"

# Uncomment following line if you want red dots to be displayed while waiting for completion
COMPLETION_WAITING_DOTS="true"

# Plugins to load (custom plugins may be added to ~/.oh-my-zsh/custom/plugins/)
plugins=(zsh-completions zsh-syntax-highlighting )


# All ZSH files inside dotfiles
typeset -U config_files
config_files=($DOTFILES/*/*.zsh)

# Load config files
for file in ${config_files}
do
  source $file
done

# Save secret crap inside ~/.localrc
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# Disable all corrections
unsetopt correct

# Completion functions installed outside Oh My Zsh must be in fpath before compinit.
typeset -U fpath
for completion_dir in "$HOME/.local/share/zsh/site-functions" /opt/homebrew/share/zsh/site-functions /usr/local/share/zsh/site-functions
do
  [[ -d "$completion_dir" ]] && fpath=("$completion_dir" $fpath)
done
unset completion_dir

# Source oh-my-zsh
source $ZSH/oh-my-zsh.sh

export PATH="/usr/local/sbin:$PATH"


# zoxide
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"


# History configuration
export HISTFILE=~/.zsh_history

# fzf history search (Ctrl+R)
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" --no-use  # Load nvm without activating Node
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
